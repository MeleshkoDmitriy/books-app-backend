# Copy this file to .env and fill in the values.
# .env is gitignored; this example is committed.

# Database. Defaults match the local Docker Postgres (docker-compose.yml).
# On Neon: DATABASE_URL is the pooled string (host contains "-pooler"),
# DIRECT_URL is the direct one used by migrations.
DATABASE_URL="postgresql://books:books@localhost:5432/books?schema=public"
DIRECT_URL="postgresql://books:books@localhost:5432/books?schema=public"

# HTTP port. Frontend dev server uses 3000, so the API takes 3001.
PORT=3001

# Auth (not wired up yet)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary (not wired up yet)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
